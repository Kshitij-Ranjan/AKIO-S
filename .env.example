# ==========================================
# AKIO'S Portfolio - Environment Configuration
# ==========================================

# Database Configuration (Docker MySQL 8.0 on port 3307)
MYSQL_URL=jdbc:mysql://localhost:3307/portfolio_db?allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password

# JWT Authentication (Auth Service & API Gateway)
JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION=86400000

# Contact & Email Service (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
CONTACT_TO_EMAIL=akioCVE@gmail.com

# Service Ports (Defaults)
# API Gateway: 8080
# Auth Service: 8081
# Project Service: 8082
# Contact Service: 8083
# Frontend (Vite): 5173
